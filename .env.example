# =============================================
# TELEGRAM
# =============================================
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token

# =============================================
# ACTUAL BUDGET
# =============================================
ACTUAL_SERVER_URL=https://your-instance.pikapods.net
ACTUAL_SERVER_PASSWORD=your_password
ACTUAL_SYNC_ID=your-sync-id-here
# Only if you enabled end-to-end encryption:
# ACTUAL_ENCRYPTION_PASSWORD=your_encryption_password

# =============================================
# GOOGLE CLOUD VISION (optional, for receipt scanning)
# =============================================
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# =============================================
# TELEGRAM USER IDs
# =============================================
# Get from @userinfobot on Telegram
USER1_TELEGRAM_ID=123456789
USER2_TELEGRAM_ID=987654321

# =============================================
# ACTUAL BUDGET ACCOUNT IDs
# =============================================
# Click an account in Actual Budget, check the URL for the ID.
# Update ACCOUNTS and USER_MAP in bot.js to match these.
ACCOUNT_USER1_SAVINGS=your-account-id
ACCOUNT_USER1_CREDIT=your-account-id
ACCOUNT_USER2_SAVINGS=your-account-id
ACCOUNT_JOINT=your-account-id

# =============================================
# AUTOMATED MESSAGES (optional)
# =============================================
# Telegram chat ID for weekly summary (Sunday 8 PM) and daily nudge (10 PM).
# Add @raw_data_bot to your group to get the chat ID.
# WEEKLY_SUMMARY_CHAT_ID=-1001234567890
# DAILY_NUDGE_CHAT_ID=-1001234567890
