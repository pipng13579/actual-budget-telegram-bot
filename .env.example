# =============================================
# TELEGRAM
# =============================================
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token

# Get user IDs from @userinfobot.
USER1_TELEGRAM_ID=123456789
USER1_NAME=User 1

USER2_TELEGRAM_ID=987654321
USER2_NAME=User 2

# Add @raw_data_bot to your family group to get the group chat ID.
# Private chats route to each user's personal budget. This group routes to
# the shared family budget.
FAMILY_GROUP_CHAT_ID=-1001234567890

# =============================================
# ACTUAL SERVER
# =============================================
# These are shared by all budget files on the same Actual server.
ACTUAL_SERVER_URL=https://your-instance.pikapods.net
ACTUAL_SERVER_PASSWORD=your_server_password

# Optional: where the API stores downloaded budget files and learned keywords.
# ACTUAL_DATA_DIR=/tmp/actual-data

# =============================================
# BUDGET FILES
# =============================================
# Account format:
# key:actual-account-id:Display Label;key2:actual-account-id:Display Label
#
# Account keys are the words you can type at the end of a message, such as:
# "lunch 12.50 credit"

# User 1 personal budget file
BUDGET_USER1_LABEL=User 1 Budget
BUDGET_USER1_SYNC_ID=sync-id-for-user-1-budget
# BUDGET_USER1_ENCRYPTION_PASSWORD=only_if_this_file_uses_e2e_encryption
BUDGET_USER1_ACCOUNTS=savings:actual-account-id:Savings Account;credit:actual-account-id:Credit Card
BUDGET_USER1_DEFAULT_ACCOUNT=savings

# User 2 personal budget file
BUDGET_USER2_LABEL=User 2 Budget
BUDGET_USER2_SYNC_ID=sync-id-for-user-2-budget
# BUDGET_USER2_ENCRYPTION_PASSWORD=only_if_this_file_uses_e2e_encryption
BUDGET_USER2_ACCOUNTS=savings:actual-account-id:Savings Account;credit:actual-account-id:Credit Card
BUDGET_USER2_DEFAULT_ACCOUNT=savings

# Shared family budget file
BUDGET_FAMILY_LABEL=Family Budget
BUDGET_FAMILY_SYNC_ID=sync-id-for-family-budget
# BUDGET_FAMILY_ENCRYPTION_PASSWORD=only_if_this_file_uses_e2e_encryption
BUDGET_FAMILY_ACCOUNTS=user1:actual-account-id:User 1 Family Account;user2:actual-account-id:User 2 Family Account;joint:actual-account-id:Joint Account
BUDGET_FAMILY_DEFAULT_ACCOUNT=joint

# Each user can have a different default account within the family budget file.
BUDGET_FAMILY_USER1_DEFAULT_ACCOUNT=user1
BUDGET_FAMILY_USER2_DEFAULT_ACCOUNT=user2

# Optional: restrict which family-budget accounts each user may select.
# If omitted, each user may select any account in BUDGET_FAMILY_ACCOUNTS.
# BUDGET_FAMILY_USER1_ACCOUNTS=user1,joint
# BUDGET_FAMILY_USER2_ACCOUNTS=user2,joint

# Optional: controls "what did I spend..." queries in the family group.
# If omitted, personal queries use that user's family default account.
# BUDGET_FAMILY_USER1_PERSONAL_ACCOUNTS=user1
# BUDGET_FAMILY_USER2_PERSONAL_ACCOUNTS=user2

# =============================================
# GOOGLE CLOUD VISION (optional, for receipt scanning)
# =============================================
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# =============================================
# AUTOMATED MESSAGES (optional)
# =============================================
# Telegram chat ID for weekly summary (Sunday 8 PM) and daily nudge (10 PM).
# Set the budget key to user1, user2, or family. If omitted, the bot infers it
# from the chat ID where possible.
# WEEKLY_SUMMARY_CHAT_ID=-1001234567890
# WEEKLY_SUMMARY_BUDGET_KEY=family
# DAILY_NUDGE_CHAT_ID=-1001234567890
# DAILY_NUDGE_BUDGET_KEY=family
